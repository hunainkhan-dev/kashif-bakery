# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (MongoDB Atlas free tier) ───────────────────
# Create a free cluster at https://www.mongodb.com/atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kashif-bakery?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────
# Must be at least 32 characters. Placeholders are REJECTED in production.
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_64_char_random_hex_string_from_the_command_above
JWT_EXPIRES_IN=7d

# ─── Seed admin (used by `npm run seed`) ──────────────────
ADMIN_EMAIL=admin@kashifbakery.com
ADMIN_PASSWORD=Admin@12345

# ─── CORS (comma-separated allowed origins) ───────────────
CLIENT_URL=http://localhost:5173

# ─── Payments (optional Stripe test) ──────────────────────
# STRIPE_SECRET_KEY=sk_test_xxx
